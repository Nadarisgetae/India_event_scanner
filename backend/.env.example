# OpenRouter Configuration
# Provide one or more free API keys separated by commas (from https://openrouter.ai/keys)
OPENROUTER_KEYS=sk-or-v1-sample-key-1,sk-or-v1-sample-key-2

# Free Tier Rate Limits & Safety Caps
OPENROUTER_DAILY_CAP_PER_KEY=45
OPENROUTER_MAX_RPM_PER_KEY=15

# Preferred Free Model Selection (Preference hierarchy, best models first)
FREE_MODEL_PREFERENCE=deepseek/deepseek-r1:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,mistralai/mistral-7b-instruct:free

# Application Metadata for OpenRouter Rankings
APP_REFERER=http://localhost:5173
APP_TITLE=India Event Impact Intelligence Tool

# Local Storage Directory
STORAGE_DIR=storage

# Server Host & Port
HOST=127.0.0.1
PORT=8000
